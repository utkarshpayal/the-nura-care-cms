# Backend (period-buddy-be). Pick one:
#   VITE_APP_ENV=prod   → https://www.backend.thenura.care
#   VITE_APP_ENV=stage  → https://stage.backend.thenura.care
# or set VITE_API_BASE_URL (no trailing slash), which wins over VITE_APP_ENV,
# e.g. a local backend. On Vercel, VITE_APP_ENV defaults from the deployment:
# Production → prod, Preview → stage.
VITE_APP_ENV=
VITE_API_BASE_URL=http://localhost:5000
